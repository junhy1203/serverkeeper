<Window x:Class="ShutdownGuard.ShutdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="종료 보호" Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#1E1E2E">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 경고 헤더 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚠" FontSize="22" Foreground="#FF5555"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="종료 보호 - 코드 확인 필요"
                       FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
        </StackPanel>

        <!-- 안내 문구 -->
        <TextBlock Grid.Row="1"
                   Text="실수 종료 방지 - 아래 코드를 입력 후 작업을 선택하세요."
                   FontSize="13" Foreground="#AAAACC" HorizontalAlignment="Center"
                   Margin="0,0,0,16" FontFamily="Segoe UI"/>

        <!-- 코드 표시 -->
        <Border Grid.Row="2" Background="#2D2D44" CornerRadius="8" Padding="20,12"
                HorizontalAlignment="Center" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="확인 코드: " FontSize="15" Foreground="#AAAACC"
                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                <TextBlock x:Name="CodeTextBlock" Text="0000"
                           FontSize="32" FontWeight="Bold"
                           Foreground="#50FA7B" VerticalAlignment="Center"
                           FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <!-- 코드 입력 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="입력: " FontSize="15" Foreground="#AAAACC"
                       VerticalAlignment="Center" FontFamily="Segoe UI" Margin="0,0,8,0"/>
            <TextBox x:Name="InputTextBox" Width="120" FontSize="22" MaxLength="4"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     Height="44" Background="#2D2D44" Foreground="White"
                     BorderBrush="#50FA7B" BorderThickness="2" CaretBrush="White"
                     FontFamily="Consolas" FontWeight="Bold"/>
        </StackPanel>

        <!-- 버튼: 종료 / 재시작 / 취소 - 항상 모두 표시 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Grid.Row="4" VerticalAlignment="Bottom">
            <Button x:Name="ShutdownButton" Content="🔴  시스템 종료"
                    Width="130" Height="40" Margin="0,0,8,0"
                    Background="#FF5555" Foreground="White" BorderThickness="0"
                    FontSize="13" FontFamily="Segoe UI" FontWeight="SemiBold"
                    Click="ShutdownButton_Click"/>
            <Button x:Name="RestartButton" Content="🔄  다시 시작"
                    Width="120" Height="40" Margin="0,0,8,0"
                    Background="#FFB86C" Foreground="White" BorderThickness="0"
                    FontSize="13" FontFamily="Segoe UI" FontWeight="SemiBold"
                    Click="RestartButton_Click"/>
            <Button x:Name="CancelButton" Content="취소"
                    Width="80" Height="40"
                    Background="#44475A" Foreground="White" BorderThickness="0"
                    FontSize="13" FontFamily="Segoe UI" FontWeight="SemiBold"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
